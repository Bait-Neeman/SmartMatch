# Dependencies (installed by `npm install` - never commit)
node_modules/

# Environment files hold secrets - never commit them (see server/.env.example)
.env
.env.*
!.env.example
*.local

# Build output
dist/
dist-ssr/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# User uploads are stored in Cloudinary, never in the repo
server/uploads/

# Vercel CLI project link
.vercel/

# Local backup of the old root-level client copy (not part of the project)
.old-root-client/

# Editor and OS files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.sw?
