# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/smartmatch

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Cloudinary dashboard > Settings > API Keys > "API environment variable"
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Optional
# CLOUDINARY_FOLDER=smartmatch
# CORS_ORIGINS=https://smart-matchmaking-system.vercel.app
# TRUST_PROXY=3

# Optional. Encrypts matchmaker access codes saved for the admin to read again.
# A long random string. When unset, the key is derived from JWT_SECRET with HKDF.
# The code is never written to the log.
# ACCESS_CODE_KEY=

# Dev only. Unset or anything other than true turns this off.
# When true, a matchmaker access code can be used again, and the member can
# skip setting an email and password. Leave this unset in production.
# ALLOW_CODE_LOGIN=true

# Password reset email. Leave SMTP_HOST or MAIL_FROM empty to skip sending.
# Outside production the reset link is printed in the server log.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="בית נאמן <no-reply@example.com>"
# CLIENT_URL=http://localhost:5173
